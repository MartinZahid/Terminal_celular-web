{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "lib": ["ES2022"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "server",
    "types": ["node", "ws"]
  },
  "include": ["server/**/*"],
  "exclude": ["node_modules", "dist"]
}
